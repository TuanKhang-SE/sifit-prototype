# Backend only. Never prefix this key with VITE_.
FASHN_API_KEY=
# demo: no provider requests; live: real FASHN v1.6 generation
TRYON_MODE=demo
# Show local demo reset; disabled automatically in live/production mode.
SIFIT_DEMO_CONTROLS=true
SIFIT_API_PORT=3001
# Global monthly image budget in addition to 5/day and 10/month per member
FASHN_MONTHLY_BUDGET=100
PYTHON_BIN=python
REMBG_MODEL=birefnet-general-lite
# For HTTPS deployment only
COOKIE_SECURE=false

# Local-only allowance reset, including live mode. Does not reset purchased API credits.
SIFIT_ACCOUNT_RESET=true

# Backend-only multimodal recommendations. Paste your own key here; never use VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
